// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id            String   @id @default(uuid())
  employeeId    String   @unique // e.g., "EMP001"
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?
  role          String // e.g., "Cashier", "Manager", "Server"
  monthlySalary Float
  profilePhoto  String?
  status        String   @default("active") // active/inactive
  departmentId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  shifts     Shift[]
  attendance Attendance[]

  @@index([departmentId])
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
}

// roles
model Roles {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// employee shift
model Shift {
  id           String   @id @default(uuid())
  employeeId   String
  shiftDate    DateTime @db.Date
  startTime    String
  endTime      String
  breakMinutes Int      @default(0)
  notes        String?
  status       String   @default("SCHEDULED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance Attendance?

  @@unique([employeeId, shiftDate])
  @@index([shiftDate, status])
}

// shift and retains an editable status for absences, leave, or corrections.
model Attendance {
  id         String    @id @default(uuid())
  employeeId String
  shiftId    String?   @unique
  date       DateTime  @db.Date
  clockIn    DateTime?
  clockOut   DateTime?
  status     String    @default("PRESENT")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date, status])
}
